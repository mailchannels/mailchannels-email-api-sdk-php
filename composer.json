{
    "name": "mailchannels/mailchannels-php",
    "description": "Official PHP SDK for the MailChannels Email API.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "mailchannels",
        "email",
        "sdk",
        "smtp",
        "psr-7",
        "psr-18"
    ],
    "homepage": "https://www.mailchannels.com/",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "symfony/http-client": "^6.4 || ^7.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 client and PSR-17 factories in one package. Recommended for most projects; install this OR symfony/http-client, not both.",
        "symfony/http-client": "Alternative PSR-18 client. Pair with nyholm/psr7 for PSR-17 factories. Install this OR guzzlehttp/guzzle, not both.",
        "nyholm/psr7": "Standalone PSR-7 messages and PSR-17 factories. Required if you pick symfony/http-client; optional with guzzlehttp/guzzle."
    },
    "autoload": {
        "psr-4": {
            "MailChannels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailChannels\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpunit": "phpunit",
        "phpstan": "phpstan analyse src tests --level=max --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
